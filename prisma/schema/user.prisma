model User {
    id           String       @id @default(uuid())
    name         String       @db.VarChar(255)
    email        String       @unique
    password     String
    activeStatus ActiveStatus @default(ACTIVATE)
    role         Role         @default(CUSTOMER)

    gears     Gear[]
    rentals   RentalOrder[]
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
    profile   Profile?

    @@map("users")
}
